# OPENROUTER_API_KEY: Recommended primary AI engine (Llama 3.3 70B, Qwen 2.5 72B, DeepSeek)
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GEMINI_API_KEY: Fallback AI engine (gemini-3.7-flash, gemini-flash-latest)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosting URL (defaults to http://localhost:3000 for local runs)
APP_URL="http://localhost:3000"

